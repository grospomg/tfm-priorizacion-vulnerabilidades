    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst vulnerabilities = items[0].json.vulnerabilities;\nreturn vulnerabilities.map(item => {\n  const cve = item.cve;\n  const cvss = cve.metrics?.cvssMetricV31?.[0]?.cvssData ||\n               cve.metrics?.cvssMetricV2?.[0]?.cvssData || {};\n  return {\n    json: {\n      cve_id: cve.id,\n      fecha_publicacion: cve.published,\n      fecha_modificacion: cve.lastModified,\n      estado: cve.vulnStatus,\n      descripcion_en: cve.descriptions?.find(d => d.lang === 'en')?.value || '',\n      descripcion_es: cve.descriptions?.find(d => d.lang === 'es')?.value || '',\n      cvss_version: cvss.version || 'N/A',\n      cvss_score: cvss.baseScore || 'N/A',\n      cvss_severidad: cvss.baseSeverity || 'N/A',\n      vector_ataque: cvss.attackVector || 'N/A',\n      fuente: 'NVD'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
